# Skopiuj do `.env.local` i uzupełnij. Plik `.env.local` jest w .gitignore.

# Publiczny, absolutny URL strony. Używany przez metadataBase, canonical, hreflang,
# sitemap i Open Graph. W buildzie produkcyjnym jest WYMAGANY i musi być adresem
# `https://` — bez niego `pnpm build` przerywa pracę, bo origin jest zapiekany
# w statycznym HTML każdego locale i nie da się go poprawić po deployu.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Adres, na który trafiają zgłoszenia z formularza kontaktowego (tylko serwer).
CONTACT_NOTIFICATION_EMAIL=

# Adres nadawcy powiadomienia. Musi być na domenie zweryfikowanej u dostawcy —
# adres klienta idzie w `reply-to`, nigdy w `from` (SPF/DKIM).
CONTACT_FROM_EMAIL=

# Klucz dostawcy e-mail. Dopóki którakolwiek z tych trzech zmiennych jest pusta,
# akcja formularza loguje zgłoszenie po stronie serwera i zwraca sukces — czyli
# NIKT go nie dostaje. Podłączenie dostawcy jest warunkiem uruchomienia strony:
# src/server/contact/contact-delivery.ts, .agents/decisions/0007-contact-delivery.md.
CONTACT_EMAIL_API_KEY=
